# Copy to server/.env for `npm run dev` (outside Docker). On Railway, set these as variables.

# Postgres. Railway: reference the plugin's variable → ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tala

# Signs session cookies. At least 32 random characters, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out (see README → rotating JWT_SECRET).
JWT_SECRET=

# The admin account is created from these on the FIRST start only (when no admin exists).
# Change the password afterwards in /admin → Change password; you can then delete ADMIN_PASSWORD.
ADMIN_EMAIL=talanasehamiri@gmail.com
ADMIN_PASSWORD=

# Sites allowed to call the API with cookies (comma-separated, no trailing slash).
CORS_ORIGINS=https://talanasehamiri.ir,https://www.talanasehamiri.ir,http://localhost:5173

# Where uploads are stored. Production default: /data/uploads (the Railway volume).
UPLOAD_DIR=./uploads

# Public URL of this API, used in upload links. Defaults to the request host.
# PUBLIC_URL=https://api.talanasehamiri.ir

PORT=8787
# Proxy hops in front of the app (Railway: 1, local: 0). Used to read the real client IP.
TRUST_PROXY=0
# Session cookie Secure flag (default: on in production). Only set to false for plain-http local use.
# COOKIE_SECURE=false

# Optional: e-mail on every new contact message (https://resend.com). Both must be set.
# RESEND_API_KEY=
# NOTIFY_EMAIL=talanasehamiri@gmail.com
# NOTIFY_FROM=Website <onboarding@resend.dev>
