# Supabase (Project Settings → API). Both values are public by design — Row Level Security
# protects the data. NEVER put the service_role / secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: who may use /admin (UX check only; the database rule is in public.is_admin()).
# VITE_ADMIN_EMAIL=talanasehamiri@gmail.com

# Without the two Supabase values the site still works: it shows the built-in content from
# src/content and the contact form opens the visitor's mail app.
