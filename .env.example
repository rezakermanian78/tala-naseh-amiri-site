# Base URL of the API (server/, deployed on Railway). No trailing slash.
#   Production (Vercel): VITE_API_URL=https://api.talanasehamiri.ir
#   Local dev: leave unset — `npm run dev` uses http://localhost:8787 automatically.
# Without it, a production build shows the built-in content from src/content and the contact
# form opens the visitor's mail app — so the site never breaks.
VITE_API_URL=
